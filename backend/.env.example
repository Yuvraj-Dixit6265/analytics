# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DESIGNER_KEY=replace-me
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me

META_DB_HOST=localhost
META_DB_PORT=3306
META_DB_USER=nexd_designer
META_DB_PASSWORD=a-strong-password
META_DB_NAME=nexd_designer

ALLOWED_ORIGINS=http://localhost:5173
QUERY_TIMEOUT_MS=15000
MAX_ROWS=5000

# Used by /api/r/<key>/<token>/email to send report PDFs through WorkFlow's
# shared branded-email system (template AR01) instead of sending SMTP
# directly — this service has no SMTP credentials of its own.
WORKFLOW_BASE_URL=http://localhost:8000
# Same shared secret WorkFlow's /api/email-templates/trigger/{mail_key}
# already checks for backend_java's calls (WorkFlow's own JAVA_SERVICE_TOKEN
# env var) — get the real value from a teammate, not from source control.
WORKFLOW_SERVICE_TOKEN=replace-me
